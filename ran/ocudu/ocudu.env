# =============================================================================
#  ran/ocudu/ocudu.env — gNB OCUDU no Kubernetes (InnovaNetwork)
#
#  ATENÇÃO: ESTE ARQUIVO DEPENDE DO SEU SETUP.
#  Os valores abaixo são do setup Innova (Intel E810-C + RU LiteOn FlexFi, split 7.2,
#  PTP grandmaster na própria E810 com GNSS). Outro hardware = outros valores, e a
#  máquina do gNB precisa estar preparada ANTES (ver docs/ocudu-k8s.md):
#    - kernel realtime, CPUs isoladas (isolcpus/nohz_full/rcu_nocbs);
#    - hugepages de 1 GB; IOMMU ligado;
#    - VF do fronthaul em vfio-pci (DPDK); PTP/GNSS funcionando (serviços do host);
#    - o .yml do gNB funcionando (testado fora do Kubernetes).
#  O projeto NÃO mexe nessa preparação: só roda o gNB num pod, com o mesmo comando.
# =============================================================================

# ---------------------------------------------------------------- nó do RAN
OCUDU_NODE="innovaserver"              # nome do nó no k3s (= hostname da máquina do gNB)
OCUDU_NODE_SSH="innovaserver@10.10.0.1" # usuário@IP para copiar arquivos ao nó (a partir do torre2)
OCUDU_NODE_IP="10.10.0.1"              # IP do nó no cluster (a fibra até o torre2)
OCUDU_NODE_IFACE="ens4f3np3"           # interface desse IP (o flannel usa ela). NUNCA a do fronthaul
OCUDU_SERVER_VIA="10.10.0.2"           # IP do torre2 na fibra: rota até o servidor do k3s (STABLE_IP)

# ---------------------------------------------------------------- gNB
OCUDU_NAMESPACE="ocudu"
OCUDU_SRC_DIR="/home/innovaserver/ocudu"          # código do OCUDU no nó (a imagem é compilada dele)
OCUDU_CONFIG_DIR="/home/innovaserver/ocudu/configs" # .yml do gNB (lidos direto do nó, como hoje)
OCUDU_DEFAULT_CONFIG="gnb_ru_liteon_SLPIT_CORE"   # .yml (sem extensão) usado se nenhum for escolhido
OCUDU_EXTRA_CONFIG="metricas.yml"      # 2º "-c" se existir na pasta (métricas do painel); "" = nenhum
OCUDU_CPUS="0-17"                      # taskset do gNB (as CPUs isoladas)
OCUDU_LOG_DIR="/tmp"                   # pasta do host montada no pod no mesmo caminho: o log.filename
                                       # do .yml (/tmp/gnb.log) continua no host, para o painel

# ---------------------------------------------------------------- imagem
OCUDU_IMAGE="innovanetwork/ocudu-gnb"  # nome local (importada no containerd do k3s; sem registry)
OCUDU_IMAGE_TAG=""                     # vazio = commit curto do OCUDU_SRC_DIR (ex.: 6fe9ad0)
OCUDU_IMAGE_OS="ubuntu"                # base da imagem (Dockerfile oficial do OCUDU)
OCUDU_IMAGE_OS_VERSION="24.04"         # igual ao host, para o build ficar próximo do nativo
OCUDU_IMAGE_MARCH="native"             # compilado na própria máquina do gNB
OCUDU_BUILD_JOBS="8"                   # o build usa só as CPUs não isoladas
