# =============================================================================
#  ran/ocudu/ocudu.env — OCUDU gNB on Kubernetes (InnovaNetwork)
#
#  WARNING: THIS FILE DEPENDS ON YOUR SETUP.
#  The values below are from the Innova setup (Intel E810-C + LiteOn FlexFi RU, split 7.2,
#  PTP grandmaster on the E810 itself with GNSS). Other hardware = other values, and the
#  gNB machine must be prepared FIRST (see docs/components/ocudu.md):
#    - realtime kernel, isolated CPUs (isolcpus/nohz_full/rcu_nocbs);
#    - 1 GB hugepages; IOMMU on;
#    - fronthaul VF in vfio-pci (DPDK); PTP/GNSS working (host services);
#    - the gNB .yml working (tested outside Kubernetes).
#  The project does NOT touch that preparation: it only runs the gNB in a pod, with the same command.
# =============================================================================

# ---------------------------------------------------------------- RAN node
OCUDU_NODE="innovaserver"              # node name in k3s (= hostname of the gNB machine)
OCUDU_NODE_SSH="innovaserver@10.10.0.1" # user@IP to copy files to the node (from torre2)
OCUDU_NODE_IP="10.10.0.1"              # node IP in the cluster (the fiber to torre2)
OCUDU_NODE_IFACE="ens4f3np3"           # interface of that IP (flannel uses it). NEVER the fronthaul one
OCUDU_SERVER_VIA="10.10.0.2"           # torre2 IP on the fiber: route to the k3s server (STABLE_IP)

# ---------------------------------------------------------------- gNB
OCUDU_NAMESPACE="ocudu"
OCUDU_SRC_DIR="/home/innovaserver/ocudu"          # OCUDU source on the node (the image is built from it)
OCUDU_CONFIG_DIR="/home/innovaserver/ocudu/configs" # gNB .yml files (read straight from the node, as before)
OCUDU_DEFAULT_CONFIG="gnb_split_open5gs"   # .yml (without extension) used if none is chosen
OCUDU_EXTRA_CONFIG="metricas.yml"      # 2nd "-c" if it exists in the folder (dashboard metrics); "" = none
OCUDU_CPUS="0-17"                      # gNB taskset (the isolated CPUs)
OCUDU_AUX_CPUS="16-17"                 # common gNB threads (log, metrics): CPUs without gNB work; empty = do not move
OCUDU_HUGEPAGES_1G="2Gi"               # 1 GB hugepages requested by the pod (Kubernetes limits the pod to
                                       # what it requests). Same as the --socket-mem of eal_args (2048 MB)
OCUDU_MEMORY_REQUEST="2Gi"             # reserved memory (no limit: the gNB is never killed by a pod OOM)
OCUDU_LOG_DIR="/tmp"                   # host folder mounted in the pod at the same path: the log.filename
                                       # of the .yml (/tmp/gnb.log) stays on the host, for the dashboard

# ---------------------------------------------------------------- image
OCUDU_IMAGE="innovanetwork/ocudu-gnb"  # local name (imported into the k3s containerd; no registry)
OCUDU_IMAGE_TAG=""                     # empty = short commit of OCUDU_SRC_DIR (e.g. 6fe9ad0)
OCUDU_IMAGE_OS="ubuntu"                # image base (official OCUDU Dockerfile)
OCUDU_IMAGE_OS_VERSION="24.04"         # same as the host, so the build stays close to the native one
OCUDU_IMAGE_MARCH="native"             # built on the gNB machine itself
OCUDU_BUILD_JOBS="8"                   # the build only uses the non-isolated CPUs
OCUDU_IMAGE_ROHC="false"               # false = without the ROHC library (header compression), like the
                                       # native gnb of innovaserver; true = downloads from rohc-lib.org
