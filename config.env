# =============================================================================
#  config.env — parâmetros do core 5G Open5GS + UERANSIM em k3s
#
#  Este arquivo é lido (source) por install.sh, test.sh, uninstall.sh e
#  scripts/subscribers.sh. É sintaxe bash: sem espaços ao redor do "=".
#  Para usar outro arquivo:  CONFIG=/caminho/meu.env sudo -E ./install.sh
#  Depois de alterar qualquer valor, rode ./install.sh de novo (idempotente).
# =============================================================================

# ----------------------------------------------------------------------------
#  Ambiente do host
# ----------------------------------------------------------------------------
# auto    -> detecta (graphical.target ou NetworkManager ativo => desktop)
# desktop -> configura NetworkManager para ignorar interfaces do k3s
# server  -> não mexe em NetworkManager
ENV_PROFILE="auto"

# Endereço do nó do k3s:
# stable -> (padrão) interface virtual própria (dummy) com IP privado fixo,
#           criada a cada boot. O cluster NÃO depende do IP do host: DHCP,
#           troca Wi-Fi/cabo ou outra rede não quebram nada. A internet (N6)
#           sai pela rota default do momento.
# iface  -> usa a interface física (comportamento antigo). Se o IP mudar,
#           é preciso rodar ./install.sh de novo.
NODE_IP_MODE="stable"
STABLE_IFACE="k3s0"            # nome da interface virtual (até 15 caracteres)
STABLE_IP="10.254.254.1"       # IP privado, fora da LAN e dos CIDRs do cluster

# Interface física/IP do host. Vazio = detecta pela rota default na hora.
# Com NODE_IP_MODE=stable só servem para a URL da WebUI e para EXPOSE_RAN.
# Desktop costuma ser Wi-Fi/enpXsY; servidor costuma ser ensX/enoX.
NODE_IFACE=""
NODE_IP=""

# Usuário que recebe o ~/.kube/config (kubectl sem sudo). Vazio = quem chamou
# o sudo ($SUDO_USER); se o script rodar como root direto, configura o root.
KUBECONFIG_USER=""
# Adicionar alias "k=kubectl" e autocomplete no ~/.bashrc desse usuário
SHELL_EXTRAS=true

# Onde ficam os charts clonados e o binário do helm (se instalado por nós)
INSTALL_DIR="/opt/open5gs-k3s"

# Instalar linux-modules-extra-$(uname -r) se o módulo sctp não existir
# (comum em kernels "virtual"/cloud de servidores).
AUTO_INSTALL_MODULES_EXTRA=true

# Se o UFW estiver ativo, liberar CIDRs do cluster e portas necessárias.
CONFIGURE_UFW=true

# Se o firewalld estiver ativo, colocar as redes do cluster na zona "trusted"
# (sem isso ele rejeita o tráfego direto entre pods: UE<->gNB e N3 gNB<->UPF).
CONFIGURE_FIREWALLD=true

# ----------------------------------------------------------------------------
#  Versões (fixadas para o desktop e o servidor ficarem iguais)
# ----------------------------------------------------------------------------
K3S_VERSION="v1.36.5+k3s1"
HELM_VERSION="v3.22.1"
GRADIANT_CHARTS_REPO="https://github.com/Gradiant/5g-charts.git"
GRADIANT_CHARTS_REF="3f998fb7c5221589957593cf7b046eabb8aecb55"   # chart open5gs 2.3.8 / Open5GS 2.7.5
OPEN5GS_IMAGE_TAG=""      # vazio = padrão do chart (2.7.5)
UERANSIM_IMAGE_TAG=""     # vazio = padrão do chart (3.2.6)

# ----------------------------------------------------------------------------
#  Kubernetes (k3s)
# ----------------------------------------------------------------------------
K8S_NAMESPACE="open5gs"
OPEN5GS_RELEASE="open5gs"     # prefixo dos serviços (open5gs-amf-ngap, ...)
UERANSIM_RELEASE="ueransim"
K3S_CLUSTER_CIDR="10.42.0.0/16"   # rede dos pods
K3S_SERVICE_CIDR="10.43.0.0/16"   # rede dos services
K3S_EXTRA_ARGS=()                 # ex.: ("--disable=metrics-server")
HELM_TIMEOUT="20m"                # 1ª instalação baixa várias imagens

# ----------------------------------------------------------------------------
#  PLMN / identidade da rede
# ----------------------------------------------------------------------------
MCC="001"          # 3 dígitos (PLMN de teste 001-01)
MNC="01"           # 2 ou 3 dígitos (zeros à esquerda contam: "01" != "001")
TAC="1"            # DECIMAL (1..16777215). Ex.: TAC 0x000064 => 100
AMF_REGION_ID="2"  # 0..255
AMF_SET_ID="1"     # 0..1023
NETWORK_NAME="InnovaSplit"

# ----------------------------------------------------------------------------
#  Slices (S-NSSAI) + DNN + pool de IPs dos UEs
#  Formato de cada item:  "SST:SD:DNN:SUBNET_CIDR"
#    SST  = 1 (eMBB), 2 (URLLC), 3 (MIoT) ...
#    SD   = 6 dígitos hexadecimais, sem 0x (obrigatório)
#    DNN  = nome do Data Network (APN)
#    SUBNET_CIDR = pool IPv4 dos UEs nessa DNN; o gateway (.1) fica no UPF
#  O PRIMEIRO item é a slice usada pelo gNB/UEs do UERANSIM.
# ----------------------------------------------------------------------------
SLICES=(
  "1:111111:internet:10.45.0.0/16"
  "2:222222:internet2:10.46.0.0/16"   # igual ao core do innovaserver (SIMs 0001 e 0022)
)
DNS_SERVERS="8.8.8.8 8.8.4.4"     # entregues ao UE na sessão PDU
UE_MTU="1400"

# ----------------------------------------------------------------------------
#  WebUI do Open5GS (admin / 1423)
# ----------------------------------------------------------------------------
WEBUI_ENABLED=true
WEBUI_NODEPORT="30999"            # http://NODE_IP:30999
OPEN5GS_METRICS=true
# ----------------------------------------------------------------------------
#  Painel de logs e métricas (Innova Center Dashboard) — docs/dashboard.md
#  Roda como pod no próprio cluster (nada roda na máquina do gNB).
# ----------------------------------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_NODEPORT="30998"        # http://NODE_IP:30998
DASHBOARD_IMAGE="python:3.12-slim"
DASHBOARD_PASSWORD=""             # vazio = sem senha; com senha: usuário "admin"
# Aba Configuração: editar este arquivo pelo painel (senha de administrador própria,
# gerada pelo install em ${INSTALL_DIR}/state/dashboard-admin-password). Salvar só grava
# o arquivo (com backup e validação); aplicar continua sendo "sudo ./install.sh ...".
DASHBOARD_CONFIG_EDIT=true
# Histórico persistente: grava TODAS as métricas (rádio com resolução de 1 s, core, máquinas,
# energia) e os eventos do core num SQLite no disco desta máquina, para comparar setups
# depois (aba Histórico + botão "Gravar experimento"). false = só os últimos minutos em memória.
DASHBOARD_PERSIST=true
DASHBOARD_PERSIST_DAYS="365"      # apaga dados mais antigos que isso (0 = nunca)
DASHBOARD_PERSIST_MAX_GB="50"     # teto do arquivo; passando disso apaga os mais antigos
DASHBOARD_HISTORY_SECONDS="900"   # histórico em memória (gráficos), em segundos
# Métricas do gNB (OCUDU): WebSocket do remote_control (vazio = sem aba Rádio)
GNB_METRICS_URL="ws://10.10.0.1:8001"
GNB_NAME="OCUDU + LiteOn"
# Log do gNB real: o agente roda NESTA máquina e lê o arquivo por SSH (tail -F).
# Vazio = desligado. Precisa de chave SSH do usuário do install para o host do gNB.
GNB_LOG_SSH="innovaserver@10.10.0.1"                 # ex.: "innovaserver@10.10.0.1"
GNB_LOG_FILE="/tmp/gnb.log"       # log: filename: da config do gNB
GNB_LOG_DROP='\[PHY *\] \[I\]'    # regex de linhas descartadas (PHY info ≈ 95% do volume); vazio = tudo
# Máquinas na aba "Máquinas" (CPU, memória, temperatura, rede, discos, processos).
# Esta máquina (core) entra sozinha. As outras são lidas por SSH a partir daqui
# (nada é instalado nelas; roda só "nice python3 -" lendo /proc a cada 2 s).
# Formato: "nome|usuario@host|papel". Precisa da mesma chave SSH do GNB_LOG_SSH.
DASHBOARD_LOCAL_ROLE="Core 5G (k3s)"
DASHBOARD_HOSTS=(
  "innovaserver|innovaserver@10.10.0.1|gNB OCUDU + LiteOn"
)
# Medidor de energia MiEnergy (monofásico) ligado a uma das máquinas: o painel lê a
# página /Data do medidor a cada 2 s (sem InfluxDB/Grafana). Vazio = desligado.
# O medidor precisa ser alcançável a partir DESTA máquina (rede do core).
ENERGY_METER_URL=""               # ex.: "http://192.168.68.105/Data"
ENERGY_METER_HOST="innovaserver"  # máquina medida (nome da aba Máquinas)
# RU (O-RU LiteOn FlexFi) na aba RU: o painel entra pela porta de gestão (RJ45) por SSH e
# roda só comandos "show" (estado, potência, temperatura, fronthaul, configuração).
# Vazio = sem aba RU. As senhas NÃO ficam aqui: o agente lê o arquivo
# /opt/open5gs-k3s/state/ru-credentials (linhas RU_PASS=... e RU_ENABLE=...), criado à mão.
RU_MGMT_IP="10.101.131.59"
RU_NAME="LiteOn FlexFi FR1"
RU_SSH_USER="user"
RU_MGMT_IFACE=""                       # interface desta máquina no switch da RU (vazio = a da rede principal)
RU_MGMT_LOCAL_CIDR="10.101.131.10/24"  # IP extra desta máquina na rede de gestão da RU (vazio = não adiciona)
RU_POLL_SECONDS="10"                   # intervalo de leitura
# Aba Controle: iniciar/parar/reiniciar cada função do core, o UERANSIM e o gNB OCUDU
# (senha de administrador da aba Configuração; precisa de DASHBOARD_CONFIG_EDIT=true).
DASHBOARD_CONTROL=true
# gNB OCUDU pela aba Controle: o agente da máquina do core roda "systemctl start/stop
# ocudu-gnb@<arquivo>" no host do gNB por SSH (mesma chave do GNB_LOG_SSH). Lá, rode uma
# vez com sudo scripts/ocudu/setup-gnb-service.sh. Vazio = sem controle do gNB.
GNB_CTL_SSH="innovaserver@10.10.0.1"
GNB_CTL_DIR="/home/innovaserver/ocudu"   # pasta do OCUDU (build/apps/gnb/gnb e configs/*.yml)
# Apelidos dos SIMs no painel ("IMSI:nome"). Os UEs do UERANSIM são marcados sozinhos.
DASHBOARD_UE_NAMES=(
  "001010000000022:Modem Telit FN990"
)
# Métricas Prometheus do Open5GS (AMF/SMF/UPF/PCF) para a aba Core.
# Mudar este valor REINICIA o core no próximo install (UEs reconectam).
OPEN5GS_METRICS=false

# ----------------------------------------------------------------------------
#  MongoDB (chart Bitnami). A imagem padrão (MongoDB 8) exige CPU com AVX.
#  Para fixar outra imagem, preencha os três campos, ex.:
#    MONGODB_IMAGE_REGISTRY="docker.io"
#    MONGODB_IMAGE_REPOSITORY="bitnamilegacy/mongodb"
#    MONGODB_IMAGE_TAG="8.0.13-debian-12-r0"
# ----------------------------------------------------------------------------
MONGODB_PERSISTENCE=true
MONGODB_PERSISTENCE_SIZE="2Gi"
MONGODB_IMAGE_REGISTRY=""
MONGODB_IMAGE_REPOSITORY=""
MONGODB_IMAGE_TAG=""

# ----------------------------------------------------------------------------
#  RAN
# ----------------------------------------------------------------------------
DEPLOY_UERANSIM=true

# Depois de cada boot, verificar se os UEs pingam o UPF e, se não, reiniciar
# em ordem UEs -> UPF/SMF/gNB (unit open5gs-k3s-heal). Manual: ./scripts/heal.sh
AUTO_HEAL=true
# Core sobe sozinho no boot? false = no boot só o painel fica no ar: a unit
# open5gs-k3s-heal PARA o core e o UERANSIM, e você inicia pela aba Controle
# ("Iniciar tudo", em ordem). Um "install.sh"/"--deploy-only" volta a subir tudo.
CORE_AUTOSTART=false

# Expor N2 (SCTP 38412) e N3 (UDP 2152) no NODE_IP para um gNB externo
# (srsRAN, OAI, gNB comercial). Experimental — ver README.
EXPOSE_RAN=false

# Link direto com o gNB real (OCUDU no innovaserver) — Multus + macvlan.
# AMF (N2) e UPF (N3) ganham uma 2ª interface (net1) com IP próprio na porta
# RAN_LINK_IFACE; o gNB simulado (UERANSIM) também usa esse link, então o
# test.sh testa o mesmo caminho do gNB real. Não use junto com EXPOSE_RAN.
# Atenção: com o link físico sem sinal (cabo/innovaserver desligado), o macvlan
# fica sem carrier e o gNB simulado também não conecta.
RAN_LINK_ENABLED=true
RAN_LINK_IFACE="enp5s0f1"         # porta do host ligada ao gNB
RAN_LINK_CIDR="10.10.0.0/24"      # rede do link (o host usa 10.10.0.2, o innovaserver 10.10.0.1)
RAN_LINK_MTU="9000"
AMF_N2_IP="10.10.0.10"            # gNB real: cu_cp.amf.addr
UPF_N3_IP="10.10.0.11"            # endereço N3 que o UPF anuncia
GNB_SIM_IP="10.10.0.20"           # gNB do UERANSIM no link
MULTUS_CHART_VERSION="v4.3.110"   # chart rke2-multus (https://rke2-charts.rancher.io)

# UEs simulados (UERANSIM). IMSI = MCC + MNC + MSIN.
# MSIN tem 15 - len(MCC) - len(MNC) dígitos (10 com MNC de 2 dígitos).
# Os UEs recebem IMSIs consecutivos a partir de UE_MSIN_START e são
# cadastrados automaticamente no core.
UE_COUNT="1"
UE_MSIN_START="0000009001"   # longe dos SIMs reais (0001, 0022, 0032, 0040, 0052)
UE_KEY="465B5CE8B199B49FAA5F0A2EE238A6BC"
UE_OPC="E8ED289DEBA952E4283B54E88E6183CA"

# ----------------------------------------------------------------------------
#  Assinantes extras (ex.: SIMs reais). Formato:
#    "IMSI:K:OPC"                 -> usa a 1ª slice/DNN
#    "IMSI:K:OPC:SST:SD:DNN"      -> slice/DNN específicos
# ----------------------------------------------------------------------------
SUBSCRIBERS=(
  # "001010000000101:465B5CE8B199B49FAA5F0A2EE238A6BC:E8ED289DEBA952E4283B54E88E6183CA"
)

# ----------------------------------------------------------------------------
#  Teste (test.sh)
# ----------------------------------------------------------------------------
TEST_PING_COUNT="4"
TEST_INTERNET=true                # pinga também um destino externo via N6
TEST_PING_TARGET="8.8.8.8"
TEST_TIMEOUT="180"                # segundos esperando registro/sessão
