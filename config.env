# =============================================================================
#  config.env — parâmetros do core 5G Open5GS + UERANSIM em k3s
#
#  Este arquivo é lido (source) por install.sh, test.sh, uninstall.sh e
#  scripts/subscribers.sh. É sintaxe bash: sem espaços ao redor do "=".
#  Para usar outro arquivo:  CONFIG=/caminho/meu.env sudo -E ./install.sh
#  Depois de alterar qualquer valor, rode ./install.sh de novo (idempotente).
# =============================================================================

# ----------------------------------------------------------------------------
#  Ambiente do host
# ----------------------------------------------------------------------------
# auto    -> detecta (graphical.target ou NetworkManager ativo => desktop)
# desktop -> configura NetworkManager para ignorar interfaces do k3s
# server  -> não mexe em NetworkManager
ENV_PROFILE="auto"

# Interface física/IP do nó. Vazio = detecta pela rota default.
# Desktop costuma ser Wi-Fi/enpXsY; servidor costuma ser ensX/enoX.
NODE_IFACE=""
NODE_IP=""

# Usuário que recebe o ~/.kube/config (kubectl sem sudo). Vazio = quem chamou
# o sudo ($SUDO_USER); se o script rodar como root direto, configura o root.
KUBECONFIG_USER=""
# Adicionar alias "k=kubectl" e autocomplete no ~/.bashrc desse usuário
SHELL_EXTRAS=true

# Onde ficam os charts clonados e o binário do helm (se instalado por nós)
INSTALL_DIR="/opt/open5gs-k3s"

# Instalar linux-modules-extra-$(uname -r) se o módulo sctp não existir
# (comum em kernels "virtual"/cloud de servidores).
AUTO_INSTALL_MODULES_EXTRA=true

# Se o UFW estiver ativo, liberar CIDRs do cluster e portas necessárias.
CONFIGURE_UFW=true

# Se o firewalld estiver ativo, colocar as redes do cluster na zona "trusted"
# (sem isso ele rejeita o tráfego direto entre pods: UE<->gNB e N3 gNB<->UPF).
CONFIGURE_FIREWALLD=true

# ----------------------------------------------------------------------------
#  Versões (fixadas para o desktop e o servidor ficarem iguais)
# ----------------------------------------------------------------------------
K3S_VERSION="v1.36.5+k3s1"
HELM_VERSION="v3.22.1"
GRADIANT_CHARTS_REPO="https://github.com/Gradiant/5g-charts.git"
GRADIANT_CHARTS_REF="3f998fb7c5221589957593cf7b046eabb8aecb55"   # chart open5gs 2.3.8 / Open5GS 2.7.5
OPEN5GS_IMAGE_TAG=""      # vazio = padrão do chart (2.7.5)
UERANSIM_IMAGE_TAG=""     # vazio = padrão do chart (3.2.6)

# ----------------------------------------------------------------------------
#  Kubernetes (k3s)
# ----------------------------------------------------------------------------
K8S_NAMESPACE="open5gs"
OPEN5GS_RELEASE="open5gs"     # prefixo dos serviços (open5gs-amf-ngap, ...)
UERANSIM_RELEASE="ueransim"
K3S_CLUSTER_CIDR="10.42.0.0/16"   # rede dos pods
K3S_SERVICE_CIDR="10.43.0.0/16"   # rede dos services
K3S_EXTRA_ARGS=()                 # ex.: ("--disable=metrics-server")
HELM_TIMEOUT="20m"                # 1ª instalação baixa várias imagens

# ----------------------------------------------------------------------------
#  PLMN / identidade da rede
# ----------------------------------------------------------------------------
MCC="001"          # 3 dígitos (PLMN de teste 001-01)
MNC="01"           # 2 ou 3 dígitos (zeros à esquerda contam: "01" != "001")
TAC="1"            # DECIMAL (1..16777215). Ex.: TAC 0x000064 => 100
AMF_REGION_ID="2"  # 0..255
AMF_SET_ID="1"     # 0..1023
NETWORK_NAME="Open5GS-K3S"

# ----------------------------------------------------------------------------
#  Slices (S-NSSAI) + DNN + pool de IPs dos UEs
#  Formato de cada item:  "SST:SD:DNN:SUBNET_CIDR"
#    SST  = 1 (eMBB), 2 (URLLC), 3 (MIoT) ...
#    SD   = 6 dígitos hexadecimais, sem 0x (obrigatório)
#    DNN  = nome do Data Network (APN)
#    SUBNET_CIDR = pool IPv4 dos UEs nessa DNN; o gateway (.1) fica no UPF
#  O PRIMEIRO item é a slice usada pelo gNB/UEs do UERANSIM.
# ----------------------------------------------------------------------------
SLICES=(
  "1:111111:internet:10.45.0.0/16"
  # "1:222222:ims:10.46.0.0/16"
)
DNS_SERVERS="8.8.8.8 8.8.4.4"     # entregues ao UE na sessão PDU
UE_MTU="1400"

# ----------------------------------------------------------------------------
#  WebUI do Open5GS (admin / 1423)
# ----------------------------------------------------------------------------
WEBUI_ENABLED=true
WEBUI_NODEPORT="30999"            # http://NODE_IP:30999

# ----------------------------------------------------------------------------
#  MongoDB (chart Bitnami). A imagem padrão (MongoDB 8) exige CPU com AVX.
#  Para fixar outra imagem, preencha os três campos, ex.:
#    MONGODB_IMAGE_REGISTRY="docker.io"
#    MONGODB_IMAGE_REPOSITORY="bitnamilegacy/mongodb"
#    MONGODB_IMAGE_TAG="8.0.13-debian-12-r0"
# ----------------------------------------------------------------------------
MONGODB_PERSISTENCE=true
MONGODB_PERSISTENCE_SIZE="2Gi"
MONGODB_IMAGE_REGISTRY=""
MONGODB_IMAGE_REPOSITORY=""
MONGODB_IMAGE_TAG=""

# ----------------------------------------------------------------------------
#  RAN
# ----------------------------------------------------------------------------
DEPLOY_UERANSIM=true

# Expor N2 (SCTP 38412) e N3 (UDP 2152) no NODE_IP para um gNB externo
# (srsRAN, OAI, gNB comercial). Experimental — ver README.
EXPOSE_RAN=false

# UEs simulados (UERANSIM). IMSI = MCC + MNC + MSIN.
# MSIN tem 15 - len(MCC) - len(MNC) dígitos (10 com MNC de 2 dígitos).
# Os UEs recebem IMSIs consecutivos a partir de UE_MSIN_START e são
# cadastrados automaticamente no core.
UE_COUNT="1"
UE_MSIN_START="0000000001"
UE_KEY="465B5CE8B199B49FAA5F0A2EE238A6BC"
UE_OPC="E8ED289DEBA952E4283B54E88E6183CA"

# ----------------------------------------------------------------------------
#  Assinantes extras (ex.: SIMs reais). Formato:
#    "IMSI:K:OPC"                 -> usa a 1ª slice/DNN
#    "IMSI:K:OPC:SST:SD:DNN"      -> slice/DNN específicos
# ----------------------------------------------------------------------------
SUBSCRIBERS=(
  # "001010000000101:465B5CE8B199B49FAA5F0A2EE238A6BC:E8ED289DEBA952E4283B54E88E6183CA"
)

# ----------------------------------------------------------------------------
#  Teste (test.sh)
# ----------------------------------------------------------------------------
TEST_PING_COUNT="4"
TEST_INTERNET=true                # pinga também um destino externo via N6
TEST_PING_TARGET="8.8.8.8"
TEST_TIMEOUT="180"                # segundos esperando registro/sessão
