# =============================================================================
#  free5gc/free5gc.env — configuration of the free5GC core (second core of the project)
#
#  What is COMMON to both cores comes from the root config.env and is not repeated here:
#  PLMN (MCC/MNC), TAC, slices (SST/SD/DNN), DNS, fiber link (RAN_LINK_*),
#  UERANSIM UEs (UE_COUNT, UE_MSIN_START, UE_KEY, UE_OPC) and SUBSCRIBERS.
#  Only what belongs to free5GC lives here. One core at a time: the IPs on the fiber are
#  different so that there is no doubt about which core the gNB is using.
# =============================================================================

F5_NAMESPACE="free5gc"
F5_VERSION="v4.3.0"                 # images free5gc/<nf>:<version> (Docker Hub)
F5_REGISTRY="docker.io/free5gc"
F5_MONGO_IMAGE="docker.io/library/mongo:7.0"
F5_MONGO_SIZE="2Gi"                 # MongoDB volume (subscribers survive restarts)

# Addresses on the fiber (RAN_LINK_CIDR network of config.env)
F5_AMF_N2_IP="10.10.0.30"           # OCUDU gNB: cu_cp.amf.addr in the free5GC .yml
F5_UPF_N3_IP="10.10.0.31"           # N3 (GTP-U) that the SMF advertises to the gNB
F5_GNB_SIM_IP="10.10.0.32"          # UERANSIM gNB of this core

# UE IP pool, one per slice, in the SAME order as SLICES in config.env
# (different from Open5GS so that routes/NAT are not confused)
F5_UE_POOLS=(
  "10.60.0.0/16"
  "10.61.0.0/16"
)

# Extra DNNs of this core only, "SST:SD:DNN:CIDR". ims exists because commercial phones ask for
# voice over IMS: without it they register and leave the cell right away (Open5GS also has ims).
F5_EXTRA_DNNS=(
  "1:111111:ims:10.62.0.0/16"
)

F5_WEBUI_NODEPORT="31000"           # WebConsole (subscribers): http://<torre2 IP>:31000
F5_NETWORK_NAME="InnovaFree5GC"     # network name on the phone (NITZ); Open5GS uses NETWORK_NAME from config.env

# UERANSIM of this core (same chart as Open5GS, another namespace)
F5_DEPLOY_UERANSIM=true
F5_UERANSIM_RELEASE="ueransim"

F5_LOG_LEVEL="info"                 # trace, debug, info, warn, error
F5_GTP5G_VERSION="v0.10.2"          # UPF kernel module (setup-gtp5g.sh). The v4.3.0 UPF accepts
                                    # 0.9.3 <= gtp5g < 0.10.3: do not use a newer one without checking
