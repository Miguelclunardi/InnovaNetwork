# =============================================================================
#  free5gc/free5gc.env — configuração do core free5GC (segundo core do projeto)
#
#  O que é COMUM aos dois cores vem do config.env da raiz e não se repete aqui:
#  PLMN (MCC/MNC), TAC, slices (SST/SD/DNN), DNS, link da fibra (RAN_LINK_*),
#  UEs do UERANSIM (UE_COUNT, UE_MSIN_START, UE_KEY, UE_OPC) e SUBSCRIBERS.
#  Aqui fica só o que é do free5GC. Um core por vez: os IPs na fibra são outros
#  para não haver dúvida de qual core o gNB está usando.
# =============================================================================

F5_NAMESPACE="free5gc"
F5_VERSION="v4.3.0"                 # imagens free5gc/<nf>:<versão> (Docker Hub)
F5_REGISTRY="docker.io/free5gc"
F5_MONGO_IMAGE="docker.io/library/mongo:7.0"
F5_MONGO_SIZE="2Gi"                 # volume do MongoDB (assinantes ficam entre reinícios)

# Endereços na fibra (rede RAN_LINK_CIDR do config.env)
F5_AMF_N2_IP="10.10.0.30"           # gNB OCUDU: cu_cp.amf.addr no .yml do free5GC
F5_UPF_N3_IP="10.10.0.31"           # N3 (GTP-U) que o SMF anuncia ao gNB
F5_GNB_SIM_IP="10.10.0.32"          # gNB do UERANSIM deste core

# Pool de IPs dos UEs, um por slice, na MESMA ordem de SLICES do config.env
# (diferente do Open5GS para não confundir rotas/NAT)
F5_UE_POOLS=(
  "10.60.0.0/16"
  "10.61.0.0/16"
)

F5_WEBUI_NODEPORT="31000"           # WebConsole (assinantes): http://<IP do torre2>:31000
F5_NETWORK_NAME_SHORT="Innova"      # nome curto mostrado no celular (o longo é o NETWORK_NAME)

# UERANSIM deste core (mesmo chart do Open5GS, outro namespace)
F5_DEPLOY_UERANSIM=true
F5_UERANSIM_RELEASE="ueransim"

F5_LOG_LEVEL="info"                 # trace, debug, info, warn, error
F5_GTP5G_VERSION="v0.10.2"          # módulo do kernel do UPF (setup-gtp5g.sh). O UPF v4.3.0 aceita
                                    # 0.9.3 <= gtp5g < 0.10.3: não use a mais nova sem conferir
